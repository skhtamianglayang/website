# Environment Variables untuk Production (Vercel)
# Copy file ini ke .env.production dan isi dengan nilai yang sebenarnya

# Database Configuration - PostgreSQL
# Pilih salah satu provider dibawah:

# OPSI 1: Vercel Postgres (Recommended)
# Dapat dari: Vercel Dashboard → Storage → Create Postgres Database
# DATABASE_URL="postgres://default:xxxx@ep-xxx.us-east-1.postgres.vercel-storage.com:5432/verceldb"

# OPSI 2: Supabase (Free Tier Bagus)
# Dapat dari: Supabase Dashboard → Settings → Database → Session Pooler
# DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# OPSI 3: Railway
# Dapat dari: Railway Dashboard → Database → Connect → Database URL
# DATABASE_URL="postgresql://postgres:password@containers-us-west-xxx.railway.app:5432/railway"

# OPSI 4: MySQL/MariaDB (jika masih pakai MySQL)
# DATABASE_URL="mysql://username:password@host:3306/database_name"

DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE"

# Session Secret - Generate random string minimal 32 karakter
# Generate dengan: openssl rand -base64 32
# JANGAN pakai yang sama dengan development!
SESSION_SECRET="GENERATE-YOUR-OWN-SECRET-KEY-MIN-32-CHARS"

# Node Environment
NODE_ENV="production"
