# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing# local env files
.env*.local
.env
.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# production build (standalone)
.next/standalone

# deployment packages
*.zip
*.tar.gz
deploy-package/

/app/generated/prisma

# documentation files (not needed in repo)
*.txt
!package-lock.json.txt

# uploaded files (user content, not part of source code)
/public/uploads/
