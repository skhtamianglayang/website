# Database Configuration
# SQLite untuk development lokal (otomatis membuat file database)
DATABASE_URL="file:./dev.db"

# Untuk production bisa gunakan PostgreSQL atau MySQL:
# PostgreSQL: DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME"
# MySQL: DATABASE_URL="mysql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME"

# Environment Mode
NODE_ENV="production"

# Server Port (akan di-set otomatis oleh cPanel)
# PORT=3000
