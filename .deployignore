# Files and directories to EXCLUDE when deploying to cPanel/CloudLinux
# CRITICAL: node_modules must NOT be deployed - CloudLinux creates a symlink

# Dependencies - handled by CloudLinux virtual environment
node_modules/

# Git files
.git/
.gitignore

# Development files
.next/
.env.local
.env.development
*.log

# Build artifacts (deploy .next/standalone instead if using standalone)
out/
build/

# Testing
coverage/
*.test.js
*.test.ts
*.spec.js
*.spec.ts

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Documentation (optional - remove if you want to deploy docs)
README.md
*.md
!STRUKTUR-PROYEK.txt

# Development tools
eslint.config.mjs
tsconfig.json
next-env.d.ts

# Package archives
*.zip
*.tar.gz
deploy-package/
